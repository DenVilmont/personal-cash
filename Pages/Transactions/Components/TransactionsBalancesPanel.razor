@using Domain.Enums

@if (VisibleRootAccounts.Count == 0)
{
    <div>
        <MudText Typo="Typo.body2" Class="mt-2">@L["No_accounts"]</MudText>
    </div>
}
else
{
    <div class="transactions-balances-panel">
        <!-- Mobile / tablet -->
        <div class="d-block d-lg-none">
            <MudExpansionPanels Class="transactions-mobile-panel-group" Elevation="2">
                <MudExpansionPanel Expanded="false" KeepContentAlive="true" Class="transactions-mobile-compact-panel">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="mr-2 transactions-mobile-compact-panel__icon" />
                            <MudText Typo="Typo.h6" Class="transactions-mobile-compact-panel__text">@L["Balances"]</MudText>
                        </MudStack>
                    </TitleContent>

                    <ChildContent>
                        <div class="transactions-mobile-panel-body">
                            <MudStack Spacing="2">
                                @foreach (var a in VisibleRootAccounts)
                                {
                                    <div class="balance-group">
                                        <div class="balance-row balance-row--mobile balance-row--surface @(a.AccountType == AccountType.Group ? "balance-row--group" : null)">
                                            <div class="balance-left">
                                                <div class="icon-option">
                                                    <MudIcon Icon="@AccountIconExtensions.FromDbKey(a.IconKey).GetIcon()" />
                                                    <span>@a.Name</span>
                                                </div>
                                            </div>

                                            <div class="balance-right">
                                                <div class="balance-actual">
                                                    <MudTooltip Text="@L["Balance_Actual_Tooltip"]" Arrow="true">
                                                        @GetBalanceActual(a).ToString("N2") @a.Currency
                                                    </MudTooltip>
                                                </div>
                                                @if (GetBalanceActual(a) != GetBalanceExpected(a))
                                                {
                                                    <div class="balance-expected text-muted">
                                                        <MudTooltip Text="@L["Balance_Expected_Tooltip"]" Arrow="true">
                                                            @GetBalanceExpected(a).ToString("N2") @a.Currency
                                                        </MudTooltip>
                                                    </div>                            
                                                }
                                            </div>
                                        </div>

                                        @if (a.AccountType == AccountType.Group)
                                        {
                                            foreach (var child in GetChildAccounts(a.Id))
                                            {
                                                if (GetBalanceActual(child) != 0 && GetBalanceExpected(child) != 0)
                                                {
                                                    <div class="balance-row balance-row--mobile balance-row--surface balance-row--child">
                                                        <div class="balance-left">
                                                            <div class="icon-option">
                                                                <MudIcon Icon="@AccountIconExtensions.FromDbKey(child.IconKey).GetIcon()" />
                                                                <span>@child.Name</span>
                                                            </div>
                                                        </div>

                                                        <div class="balance-right">
                                                            <div class="balance-actual">
                                                                <MudTooltip Text="@L["Balance_Actual_Tooltip"]" Arrow="true">
                                                                    @child.BalanceActual.ToString("N2") @child.Currency
                                                                </MudTooltip>
                                                            </div>
                                                            @if (GetBalanceActual(child) != GetBalanceExpected(child))
                                                            {
                                                                <div class="balance-expected text-muted">
                                                                    <MudTooltip Text="@L["Balance_Expected_Tooltip"]" Arrow="true">
                                                                        @child.BalanceExpected.ToString("N2") @child.Currency
                                                                    </MudTooltip>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                }
                            </MudStack>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </div>

        <!-- Desktop -->
        <div class="d-none d-lg-block">
            <MudPaper Class="pa-4 transactions-balances-panel__desktop-card">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" class="mr-2" />
                    <MudText Typo="Typo.h5">@L["Balances"]</MudText>
                </MudStack>

                <MudStack Spacing="2" Class="mt-3">
                    @foreach (var a in VisibleRootAccounts)
                    {
                        <div class="balance-group">
                            <div class="balance-row balance-row--surface @(a.AccountType == AccountType.Group ? "balance-row--group" : null)">
                                <div class="balance-left">
                                    <div class="icon-option">
                                        <MudIcon Icon="@AccountIconExtensions.FromDbKey(a.IconKey).GetIcon()" />
                                        <span>@a.Name</span>
                                    </div>
                                </div>

                                <div class="balance-right">
                                    <div class="balance-actual">
                                        <MudTooltip Text="@L["Balance_Actual_Tooltip"]" Arrow="true">
                                            @GetBalanceActual(a).ToString("N2") @a.Currency
                                        </MudTooltip>
                                    </div>
                                    @if (GetBalanceActual(a) != GetBalanceExpected(a))
                                    {
                                        <div class="balance-expected text-muted">
                                            <MudTooltip Text="@L["Balance_Expected_Tooltip"]" Arrow="true">
                                                @GetBalanceExpected(a).ToString("N2") @a.Currency
                                            </MudTooltip>
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (a.AccountType == AccountType.Group)
                            {
                                foreach (var child in GetChildAccounts(a.Id))
                                {
                                    if (GetBalanceActual(child) != 0 && GetBalanceExpected(child) != 0)
                                    {
                                        <div class="balance-row balance-row--surface balance-row--child">
                                            <div class="balance-left">
                                                <div class="icon-option">
                                                    <MudIcon Icon="@AccountIconExtensions.FromDbKey(child.IconKey).GetIcon()" />
                                                    <span>@child.Name</span>
                                                </div>
                                            </div>

                                            <div class="balance-right">
                                                <div class="balance-actual">
                                                    <MudTooltip Text="@L["Balance_Actual_Tooltip"]" Arrow="true">
                                                        @child.BalanceActual.ToString("N2") @child.Currency
                                                    </MudTooltip>
                                                </div>
                                                @if (GetBalanceActual(child) != GetBalanceExpected(child))
                                                {
                                                    <div class="balance-expected text-muted">
                                                        <MudTooltip Text="@L["Balance_Expected_Tooltip"]" Arrow="true">
                                                            @child.BalanceExpected.ToString("N2") @child.Currency
                                                        </MudTooltip>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                </MudStack>
            </MudPaper>
        </div>
    </div>
}